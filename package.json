{
  "name": "strike-zone-desktop",
  "version": "1.5.7",
  "description": "Strike Zone 2D — gra na Windows z launcherem i aktualizacjami",
  "author": "Konrad Xocent",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "npm run prepare:game && electron .",
    "prepare:game": "node scripts/prepare-game.cjs",
    "test": "npm run test:unit && npm run test:core-maps",
    "dist:win": "npm run prepare:game && node scripts/build.cjs",
    "dist:win:test": "npm run prepare:game && node scripts/build.cjs --test",
    "configure:updates": "node scripts/configure-updates.cjs",
    "release": "node scripts/release.cjs",
    "test:gameplay": "node scripts/gameplay-smoke.cjs",
    "maps:compile": "node scripts/compile-maps.cjs",
    "maps:check": "node scripts/compile-maps.cjs --check",
    "test:creator": "node scripts/creator-smoke.cjs",
    "test:launcher": "npm run prepare:game && node scripts/launcher-smoke.cjs",
    "test:friends": "npm run prepare:game && node scripts/friends-smoke.cjs",
    "test:loadout": "node scripts/loadout-buy-smoke.cjs",
    "test:hub": "npm run prepare:game && node scripts/hub-smoke.cjs",
    "test:controls": "npm run prepare:game && node scripts/controls-smoke.cjs",
    "test:materials": "npm run prepare:game && node scripts/materials-smoke.cjs",
    "test:workshop-maps": "npm run prepare:game && node scripts/workshop-maps-smoke.cjs",
    "test:community": "node scripts/community-smoke.cjs",
    "prepare:preview": "node scripts/prepare-preview.cjs",
    "test:preview": "npm run prepare:game && node scripts/preview-smoke.cjs",
    "test:social": "npm run prepare:game && node scripts/social-smoke.cjs",
    "test:network": "node scripts/network-smoke.cjs",
    "check:ui": "node scripts/check-ui.cjs",
    "test:moderation": "npm run prepare:game && node scripts/moderation-smoke.cjs",
    "test:locale": "npm run prepare:game && node scripts/locale-smoke.cjs",
    "test:hide-seek": "npm run prepare:game && node scripts/hide-seek-smoke.cjs",
    "test:prop-hunt": "npm run prepare:game && node scripts/prop-hunt-smoke.cjs",
    "test:minigames": "npm run prepare:game && node scripts/minigames-smoke.cjs",
    "test:halloween": "npm run prepare:game && node scripts/halloween-smoke.cjs",
    "test:seasonal": "npm run prepare:game && node scripts/seasonal-smoke.cjs",
    "test:spectator": "node scripts/spectator-smoke.cjs",
    "test:launcher-social": "npm run prepare:game && node scripts/launcher-social-smoke.cjs",
    "test:modes-hud": "node scripts/modes-hud-smoke.cjs",
    "test:arcade-ui": "npm run prepare:game && node scripts/arcade-presentation-smoke.cjs",
    "test:agents": "npm run prepare:game && node scripts/agents-smoke.cjs",
    "test:gloves": "npm run prepare:game && node scripts/gloves-smoke.cjs",
    "test:money": "npm run prepare:game && node scripts/money-smoke.cjs",
    "test:creator-modes": "npm run prepare:game && node scripts/creator-modes-smoke.cjs",
    "test:objectives": "npm run prepare:game && node scripts/objective-modes-smoke.cjs",
    "test:match-presentation": "npm run prepare:game && node scripts/match-presentation-smoke.cjs",
    "test:core-maps": "node scripts/core-maps-smoke.cjs",
    "test:unit": "node --test tests/*.test.cjs",
    "pretest": "node scripts/ensure-generated.cjs",
    "start:platform": "electron platform/main.cjs",
    "dist:platform": "node scripts/ensure-generated.cjs && npm run prepare:game && node scripts/build-platform.cjs",
    "dist:managed": "npm run prepare:game && node scripts/build-managed.cjs",
    "test:platform": "node --test tests/zone-hub*.test.cjs",
    "test:platform-ui": "node scripts/zone-hub-smoke.cjs && node scripts/zone-hub-handoff-smoke.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@napi-rs/canvas": "0.1.80",
    "acorn": "8.15.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0",
    "pe-library": "2.0.1",
    "playwright-core": "1.62.1",
    "resedit": "3.1.0"
  }
}
